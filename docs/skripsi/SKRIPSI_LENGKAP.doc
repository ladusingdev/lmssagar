<tr><th>Kode</th><th>Kebutuhan</th></tr>
<tr><td>F-S01</td><td>Siswa dapat login dan melihat dashboard aktivitas belajarnya</td></tr>
<tr><td>F-S02</td><td>Siswa dapat melihat dan mengunduh materi pembelajaran</td></tr>
